# Copy this file to .env.local for local development, and add the same two
# values as repository secrets in GitHub (Settings → Secrets and variables →
# Actions) named NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY
# so the GitHub Actions build can bake them into the static export.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
